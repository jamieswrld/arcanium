[Unit]
Description=Arcanium Arc indexer
Documentation=https://arcanium.trade
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arcanium
WorkingDirectory=/opt/arcanium
ExecStart=/usr/bin/node /opt/arcanium/apps/indexer/dist/main.js

# Secrets live in a root-owned file the service user can read, never in this
# unit — systemd unit files are world-readable.
EnvironmentFile=/etc/arcanium/indexer.env

# The indexer is a loop that catches its own errors; if it exits at all,
# something is badly wrong, so come straight back rather than giving up.
Restart=always
RestartSec=5
# ...but if it crashes on startup in a tight loop, stop and leave the failure
# visible instead of hammering both the RPC and the database.
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=arcanium-indexer

# It needs the network and nothing else on this box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/arcanium
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G

[Install]
WantedBy=multi-user.target
