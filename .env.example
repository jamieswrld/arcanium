# Arch environment template. Copy to .env and fill in per environment.
# NOTHING here unlocks real funds: the three gates below default to false and
# must only be flipped after the address book is verified against official
# Arc/Circle/Uniswap sources (ADR 0006).

NODE_ENV=development
LOG_LEVEL=info

# ---- Feature gates -----------------------------------------------------------
ENABLE_ARC_MAINNET=false
ENABLE_REAL_BRIDGE=false
ENABLE_REAL_TRADING=false

# ---- Fees (basis points / raw 6-decimal quote units) -------------------------
BRIDGE_DEPOSIT_FEE_BPS=1500
BRIDGE_REDEEM_FEE_BPS=0
PAIR_FEE_CREATOR_SHARE_BPS=3000
PAIR_FEE_PROTOCOL_SHARE_BPS=7000
GAS_STATION_MARGIN_BPS=500
UNISWAP_POOL_FEE=10000
# 105% of Envelope's on-chain launchFee() of 50_000_000 (verified 2026-07-28).
LAUNCH_FEE_QUOTE_UNITS=52500000

# ---- Bridge limits and policy (raw 6-decimal units) --------------------------
BRIDGE_MIN_DEPOSIT_UNITS=25000000
BRIDGE_MAX_DEPOSIT_UNITS=100000000000
BRIDGE_MAX_RELEASE_PER_TX_UNITS=100000000000
BRIDGE_MAX_RELEASE_PER_WINDOW_UNITS=500000000000
BRIDGE_RELEASE_WINDOW_SECONDS=3600

# ---- Graduation (9,000 quote units, 6 decimals) ------------------------------
GRADUATION_QUOTE_UNITS=9000000000

# ---- Base Sepolia ------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_EXPLORER_URL=https://sepolia.basescan.org
BASE_SEPOLIA_CHAIN_ID=84532
# Circle's Base Sepolia USDC — verify at https://developers.circle.com before use.
BASE_SEPOLIA_USDC_ADDRESS=
BASE_SEPOLIA_CONFIRMATIONS=10

# ---- Base Mainnet ------------------------------------------------------------
BASE_MAINNET_RPC_URL=
BASE_MAINNET_EXPLORER_URL=https://basescan.org
BASE_MAINNET_CHAIN_ID=8453
# Canonical Base USDC (verify against Circle docs): 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_MAINNET_USDC_ADDRESS=
BASE_MAINNET_CONFIRMATIONS=30

# ---- Arc Testnet -------------------------------------------------------------
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_TESTNET_CONFIRMATIONS=5

# ---- Arc Mainnet (leave empty until officially verified — ADR 0006) ----------
ARC_MAINNET_RPC_URL=
ARC_MAINNET_EXPLORER_URL=
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_USDC_ADDRESS=
ARC_MAINNET_CONFIRMATIONS=10

# ---- Uniswap v3 on the active Arc network (no compiled-in defaults) ----------
UNISWAP_V3_FACTORY_ADDRESS=
UNISWAP_V3_POSITION_MANAGER_ADDRESS=
UNISWAP_V3_SWAP_ROUTER_ADDRESS=
UNISWAP_V3_QUOTER_ADDRESS=

# ---- Arch contract addresses (filled per deployment) -------------------------
ARCH_USD_ADDRESS=
ARCH_VAULT_BASE_ADDRESS=
ARCH_BRIDGE_ARC_ADDRESS=
ARCH_GAS_STATION_ADDRESS=
ARCH_LAUNCHPAD_FACTORY_ADDRESS=
ARCH_LIQUIDITY_VAULT_ADDRESS=
ARCH_FEE_DISTRIBUTOR_ADDRESS=
ARCH_GRADUATION_REGISTRY_ADDRESS=

# ---- Infrastructure ----------------------------------------------------------
DATABASE_URL=postgres://arch:arch@localhost:5432/arch
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=arch-media
S3_ACCESS_KEY_ID=arch
S3_SECRET_ACCESS_KEY=arch-secret

# ---- Service ports -----------------------------------------------------------
API_PORT=4000
ADMIN_PORT=4100
GAS_RELAYER_PORT=4200
METRICS_PORT=9464

# Keeper/relayer keys are provisioned via secret managers in deployed
# environments — never via frontend env, never on shared app servers, and never
# committed. Local development uses anvil's throwaway accounts.
